<section class="py-8">
  <% if (typeof currentSort !== 'undefined' && currentSort) { %>
    <h1 class="text-2xl font-bold mb-6"><%= currentSort.sortname %></h1>
  <% } else if (typeof currentTag !== 'undefined' && currentTag) { %>
    <h1 class="text-2xl font-bold mb-6">#<%= currentTag.tagname %></h1>
  <% } else if (typeof currentMappoint !== 'undefined' && currentMappoint) { %>
    <h1 class="text-2xl font-bold mb-6"><%= currentMappoint.title %></h1>
  <% } %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(function(post) { %>
        <%- include('../components/post-card', { post: post, lang: lang }) %>
      <% }); %>
    <% } else { %>
      <div class="col-span-3 text-center py-16 text-gray-400 dark:text-gray-500">
        No posts found.
      </div>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
    <%
      var baseUrl;
      if (typeof currentSort !== 'undefined' && currentSort) {
        baseUrl = '/' + lang + '/post/list/sort/' + currentSort._id;
      } else if (typeof currentTag !== 'undefined' && currentTag) {
        baseUrl = '/' + lang + '/post/list/tag/' + currentTag._id;
      } else if (typeof currentMappoint !== 'undefined' && currentMappoint) {
        baseUrl = '/' + lang + '/post/list/mappoint/' + currentMappoint._id;
      } else {
        baseUrl = '/' + lang + '/post/list';
      }
    %>
    <%- include('../components/pagination', { page: page, totalPages: totalPages, baseUrl: baseUrl }) %>
  <% } %>
</section>
