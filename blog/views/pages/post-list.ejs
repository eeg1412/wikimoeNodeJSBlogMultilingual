<!DOCTYPE html>
<html lang="<%= page.lang %>">
  <head>
    <%- include('../partials/head', { page: page, site: site }) %>
  </head>
  <body class="min-h-screen px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <%- include('../partials/header', { page: page, site: site }) %>
      <main class="mt-6">
        <section class="surface-card mb-6">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">文章列表</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
            当前页 <%= pagination.page %> / <%= pagination.totalPages || 1 %> ，共 <%= pagination.total %> 篇。
          </p>
        </section>
        <section class="grid gap-6 lg:grid-cols-2">
          <% if (list && list.length > 0) { %>
            <% list.forEach(function (post) { %>
              <%- include('../components/post-card', { post: post, page: page }) %>
            <% }) %>
          <% } else { %>
            <div class="surface-card lg:col-span-2">
              <p class="text-sm leading-7 text-slate-600 dark:text-slate-300">当前筛选条件下暂无文章。</p>
            </div>
          <% } %>
        </section>
      </main>
      <%- include('../partials/footer', { page: page, site: site }) %>
    </div>
  </body>
</html>