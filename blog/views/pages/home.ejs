<!DOCTYPE html>
<html lang="<%= page.lang %>" class="<%= site.themeMode === 'dark' ? 'dark' : '' %>">
  <head>
    <%- include('../partials/head', { page: page, site: site }) %>
  </head>
  <body class="min-h-screen px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto flex min-h-[calc(100vh-3rem)] w-full max-w-7xl flex-col gap-6">
      <%- include('../partials/header', { page: page, site: site }) %>
      <main class="flex-1">
        <section class="hero-shell">
          <div class="hero-grid">
            <div>
              <p class="chip">Phase 0 / Phase 1</p>
              <h2 class="mt-5 max-w-3xl font-serif text-4xl font-black leading-tight text-slate-900 dark:text-white md:text-6xl">
                多语言附属站已经具备独立启动骨架。
              </h2>
              <p class="mt-6 max-w-2xl text-base leading-8 text-slate-600 dark:text-slate-300 md:text-lg">
                当前版本已经落地启动级 env、管理员 JWT 密钥文件、Mongo 初始化、settings 表和初始管理员引导。
                下一步会继续接入导入、翻译、后台登录与文章编辑链路。
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
              <div class="surface-card">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-700 dark:text-teal-300">Admin</p>
                <p class="mt-4 text-3xl font-black text-slate-900 dark:text-white">/multilingual-admin</p>
                <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">后台构建输出挂载到服务端，后续在这里接登录、导入、编辑与安全管理。</p>
              </div>
              <div class="surface-card">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-700 dark:text-cyan-300">Language</p>
                <p class="mt-4 text-3xl font-black text-slate-900 dark:text-white"><%= page.lang %></p>
                <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">当前首页已按语言前缀进入 SSR 页面链路。</p>
              </div>
            </div>
          </div>
        </section>
        <section class="mt-6 grid gap-6 lg:grid-cols-2">
          <% if (list && list.length > 0) { %>
            <% list.forEach(function (post) { %>
              <%- include('../components/post-card', { post: post, page: page }) %>
            <% }) %>
          <% } else { %>
            <div class="surface-card lg:col-span-2">
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white">暂无已发布文章</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
                请先在后台完成导入、翻译确认和发布。
              </p>
            </div>
          <% } %>
        </section>
      </main>
      <%- include('../partials/footer', { page: page, site: site }) %>
    </div>
  </body>
</html>