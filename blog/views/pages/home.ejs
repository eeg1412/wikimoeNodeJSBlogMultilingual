<section class="py-8">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(function(post) { %>
        <%- include('../components/post-card', { post: post, lang: lang }) %>
      <% }); %>
    <% } else { %>
      <div class="col-span-3 text-center py-16 text-gray-400 dark:text-gray-500">
        No posts yet.
      </div>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
    <%- include('../components/pagination', { page: page, totalPages: totalPages, baseUrl: '/' + lang + '/post/list' }) %>
  <% } %>
</section>
