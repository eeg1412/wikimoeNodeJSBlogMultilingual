<!DOCTYPE html>
<html lang="<%= page.lang %>">
  <head>
    <%- include('../partials/head', { page: page, site: site }) %>
  </head>
  <body class="min-h-screen px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <%- include('../partials/header', { page: page, site: site }) %>
      <main class="mt-6">
        <%- include('../components/post-detail', { post: post }) %>
        <% if (post.bangumiList.length > 0) { %>
          <div class="mt-6">
            <%- include('../components/entity-panel', {
              title: 'Bangumi',
              description: post.bangumiList.map(function (item) { return item.title }).join(' / ')
            }) %>
          </div>
        <% } %>
        <% if (post.movieList.length > 0) { %>
          <div class="mt-6">
            <%- include('../components/entity-panel', {
              title: 'Movie',
              description: post.movieList.map(function (item) { return item.title }).join(' / ')
            }) %>
          </div>
        <% } %>
        <% if (post.gameList.length > 0) { %>
          <div class="mt-6">
            <%- include('../components/entity-panel', {
              title: 'Game',
              description: post.gameList.map(function (item) { return item.title }).join(' / ')
            }) %>
          </div>
        <% } %>
        <% if (post.bookList.length > 0) { %>
          <div class="mt-6">
            <%- include('../components/entity-panel', {
              title: 'Book',
              description: post.bookList.map(function (item) { return item.title }).join(' / ')
            }) %>
          </div>
        <% } %>
        <% if (post.eventList.length > 0) { %>
          <div class="mt-6">
            <%- include('../components/entity-panel', {
              title: 'Event',
              description: post.eventList.map(function (item) { return item.title }).join(' / ')
            }) %>
          </div>
        <% } %>
        <% if (post.voteList.length > 0) { %>
          <div class="mt-6 grid gap-6">
            <% post.voteList.forEach(function (vote) { %>
              <%- include('../components/vote-readonly-card', { vote: vote }) %>
            <% }) %>
          </div>
        <% } %>
      </main>
      <%- include('../partials/footer', { page: page, site: site }) %>
    </div>
  </body>
</html>