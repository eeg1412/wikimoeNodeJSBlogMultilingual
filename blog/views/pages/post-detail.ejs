<% canonicalUrl = post.canonicalUrl %>
<% metaDescription = post.metaDescription %>
<% if (post.hreflang && post.hreflang.length > 0) { hreflang = post.hreflang } %>

<article class="py-8 max-w-3xl mx-auto">
  <!-- 封面 -->
  <% if (post.coverImages && post.coverImages.length > 0) { %>
    <div class="mb-6 rounded-lg overflow-hidden">
      <img src="<%= post.coverImages[0].src %>"
           alt="<%= post.title %>"
           class="w-full object-cover max-h-96"
           loading="eager" />
    </div>
  <% } %>

  <!-- 标题 -->
  <h1 class="text-3xl font-bold leading-snug mb-4"><%= post.title %></h1>

  <!-- 元信息 -->
  <%- include('../components/post-meta', { post: post, lang: lang }) %>

  <!-- 摘要 -->
  <% if (post.excerpt) { %>
    <p class="mt-6 text-gray-600 dark:text-gray-400 border-l-4 border-blue-500 pl-4 italic">
      <%= post.excerpt %>
    </p>
  <% } %>

  <!-- 正文 -->
  <div class="post-content mt-8 prose prose-gray dark:prose-invert max-w-none">
    <%- post.content %>
  </div>

  <!-- 标签 -->
  <% if (post.tags && post.tags.length > 0) { %>
    <div class="mt-8 flex flex-wrap gap-2">
      <% post.tags.forEach(function(tag) { %>
        <a href="/<%= lang %>/post/list/tag/<%= tag._id %>"
           class="text-sm bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700">
          #<%= tag.tagname %>
        </a>
      <% }); %>
    </div>
  <% } %>

  <!-- 关联实体（只读展示） -->
  <% var hasEntities = post.entities &&
    (post.entities.bangumiList.length + post.entities.movieList.length +
     post.entities.gameList.length + post.entities.bookList.length + post.entities.eventList.length) > 0 %>
  <% if (hasEntities) { %>
    <div class="mt-10 border-t border-gray-200 dark:border-gray-700 pt-8">
      <%- include('../components/entity-panel', { entities: post.entities, lang: lang }) %>
    </div>
  <% } %>

  <!-- 投票（只读） -->
  <% if (post.entities && post.entities.voteList && post.entities.voteList.length > 0) { %>
    <div class="mt-8 space-y-4">
      <% post.entities.voteList.forEach(function(vote) { %>
        <%- include('../components/vote-readonly-card', { vote: vote }) %>
      <% }); %>
    </div>
  <% } %>
</article>
