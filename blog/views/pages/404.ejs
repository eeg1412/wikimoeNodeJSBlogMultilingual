<%# 404 页面 %>
<!DOCTYPE html>
<html lang="<%= lang || 'en' %>" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Not Found</title>
    <link rel="stylesheet" href="/assets/blog.css" />
  </head>
  <body
    class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col items-center justify-center"
  >
    <div class="text-center">
      <h1 class="text-6xl font-bold text-gray-300 dark:text-gray-600">404</h1>
      <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
        Page Not Found
      </p>
      <a
        href="/<%= lang || 'en' %>"
        class="mt-6 inline-block px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
      >
        Go Home
      </a>
    </div>
  </body>
</html>
