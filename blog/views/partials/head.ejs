<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%
  const resolvedSiteTitle = typeof siteTitle !== 'undefined' ? siteTitle : (siteConfig.siteName || '')
  const resolvedPageTitle = typeof pageTitle !== 'undefined' ? pageTitle : ''
  let documentTitle = resolvedSiteTitle
  if (resolvedPageTitle && resolvedSiteTitle) {
    documentTitle = resolvedPageTitle + ' - ' + resolvedSiteTitle
  } else if (resolvedPageTitle) {
    documentTitle = resolvedPageTitle
  }
%>
<title><%= documentTitle %></title>

<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
  <meta name="description" content="<%= metaDescription %>" />
<% } else if (typeof siteDescription !== 'undefined' && siteDescription) { %>
  <meta name="description" content="<%= siteDescription %>" />
<% } else if (siteConfig.description) { %>
  <meta name="description" content="<%= siteConfig.description %>" />
<% } %>

<% if (siteConfig.keywords) { %>
  <meta name="keywords" content="<%= siteConfig.keywords %>" />
<% } %>

<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>" />
<% } %>

<% if (typeof hreflang !== 'undefined' && hreflang && hreflang.length > 0) { %>
  <% hreflang.forEach(function(alt) { %>
    <link rel="alternate" hreflang="<%= alt.lang %>" href="<%= alt.url %>" />
  <% }); %>
<% } %>

<!-- Open Graph -->
<meta property="og:type" content="<%= (typeof post !== 'undefined') ? 'article' : 'website' %>" />
<meta property="og:title" content="<%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : (typeof siteTitle !== 'undefined' ? siteTitle : (siteConfig.siteName || '')) %>" />
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
  <meta property="og:description" content="<%= metaDescription %>" />
<% } %>
<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <meta property="og:url" content="<%= canonicalUrl %>" />
<% } %>
<% if (typeof post !== 'undefined' && post && post.coverSrc) { %>
  <meta property="og:image" content="<%= post.coverSrc %>" />
<% } %>

<!-- Favicon -->
<% if (siteConfig.favicon) { %>
  <link rel="icon" href="<%= siteConfig.favicon %>" />
<% } %>

<!-- 博客端样式 -->
<link rel="stylesheet" href="/assets/blog.css" />

<% if (siteConfig.extraCss) { %>
  <style><%= siteConfig.extraCss %></style>
<% } %>
