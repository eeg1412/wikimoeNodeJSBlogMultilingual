<footer class="border-t border-gray-200 dark:border-gray-700 py-8 mt-16">
  <div class="container mx-auto px-4 max-w-4xl text-center text-sm text-gray-500 dark:text-gray-400">
    <% if (siteConfig.footerInfo) { %>
      <p><%= siteConfig.footerInfo %></p>
    <% } else { %>
      <p>&copy; <%= new Date().getFullYear() %> <%= siteConfig.siteName || siteConfig.title || '' %></p>
    <% } %>
  </div>
</footer>
