<header class="border-b border-gray-200 dark:border-gray-700 py-4">
  <div class="container mx-auto px-4 max-w-4xl flex items-center justify-between">
    <a href="/<%= lang %>" class="text-xl font-bold text-gray-900 dark:text-white hover:opacity-80">
      <%= siteConfig.siteName || siteConfig.title || '' %>
    </a>

    <div class="flex items-center gap-4">
      <% if (typeof sortList !== 'undefined' && sortList && sortList.length > 0) { %>
        <nav class="hidden md:flex items-center gap-3 text-sm">
          <% sortList.slice(0, 5).forEach(function(sort) { %>
            <a href="/<%= lang %>/post/list/sort/<%= sort._id %>"
               class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">
              <%= sort.sortname %>
            </a>
          <% }); %>
        </nav>
      <% } %>

      <% if (siteConfig.allowSwitchTheme) { %>
        <button id="theme-toggle" class="p-2 rounded-md text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800" aria-label="Toggle theme">
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
      <% } %>
    </div>
  </div>
</header>
