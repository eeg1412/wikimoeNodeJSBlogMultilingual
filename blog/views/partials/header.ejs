<header
  class="surface-card flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
>
  <div>
    <p class="chip"><%= page.lang %></p>
    <h1
      class="mt-4 text-2xl font-black tracking-tight text-slate-900 dark:text-white md:text-3xl"
    >
      <%= site.title || 'wikimoeNodeJSBlogMultilingual' %>
    </h1>
    <p
      class="mt-2 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300"
    >
      <%= site.description || '独立部署的多语言附属站' %>
    </p>
  </div>
  <div
    class="flex flex-wrap gap-3 text-sm font-medium text-slate-600 dark:text-slate-300"
  >
    <span
      class="rounded-full border border-slate-300/70 px-4 py-2 dark:border-slate-700"
      >SSR</span
    >
    <span
      class="rounded-full border border-slate-300/70 px-4 py-2 dark:border-slate-700"
      >EJS 5.0.2</span
    >
    <span
      class="rounded-full border border-slate-300/70 px-4 py-2 dark:border-slate-700"
      >TailwindCSS 3.4.17</span
    >
  </div>
</header>
