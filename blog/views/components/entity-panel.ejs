<%# 关联实体面板（只读，无交互） %>
<%# 参数：entities (EntityPanel ViewModel), lang (string) %>

<% function renderEntityList(list, label) { %>
  <% if (list && list.length > 0) { %>
    <div class="mb-6">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">
        <%= label %>
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% list.forEach(function(entity) { %>
          <div class="border border-gray-200 dark:border-gray-700 rounded p-3">
            <p class="font-medium text-sm"><%= entity.title %></p>
            <% if (entity.description) { %>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
                <%= entity.description %>
              </p>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
<% } %>

<% renderEntityList(entities.bangumiList, 'Bangumi') %>
<% renderEntityList(entities.movieList, 'Movies') %>
<% renderEntityList(entities.gameList, 'Games') %>
<% renderEntityList(entities.bookList, 'Books') %>
<% renderEntityList(entities.eventList, 'Events') %>
