<article class="surface-card">
  <p class="chip"><%= post.typeText %></p>
  <h2 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">
    <a class="no-underline text-inherit" href="/<%= page.lang %>/post/<%= post.alias %>"><%= post.title %></a>
  </h2>
  <% if (post.coverImage) { %>
    <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200/70 dark:border-slate-700/70">
      <img
        src="<%= post.coverImage.url %>"
        alt="<%= post.title %>"
        class="h-56 w-full object-cover"
        loading="lazy"
      />
    </div>
  <% } %>
  <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300"><%= post.excerpt %></p>
  <% if (post.author || post.sort || (post.tags && post.tags.length > 0)) { %>
    <%- include('./post-meta', { meta: {
      author: post.author ? post.author.nickname : '',
      date: post.date ? new Date(post.date).toLocaleDateString('zh-CN') : '',
      sort: post.sort ? post.sort.sortname : '',
      tags: post.tags || []
    } }) %>
  <% } %>
</article>