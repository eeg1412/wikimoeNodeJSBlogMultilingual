<%# 文章卡片组件 %>
<%# 参数：post (ViewModel), lang (string) %>
<article class="group border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
  <% if (post.coverSrc) { %>
    <a href="/<%= lang %>/post/<%= post.alias || post._id %>">
      <img src="<%= post.coverSrc %>"
           alt="<%= post.title %>"
           loading="lazy"
           class="w-full h-48 object-cover group-hover:opacity-90 transition-opacity" />
    </a>
  <% } %>

  <div class="p-4">
    <% if (post.sort) { %>
      <a href="/<%= lang %>/post/list/sort/<%= post.sort._id %>"
         class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
        <%= post.sort.sortname %>
      </a>
    <% } %>

    <h2 class="mt-1 text-lg font-semibold leading-snug">
      <a href="/<%= lang %>/post/<%= post.alias || post._id %>"
         class="hover:text-blue-600 dark:hover:text-blue-400">
        <%= post.title %>
      </a>
    </h2>

    <% if (post.excerpt) { %>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-3">
        <%= post.excerpt %>
      </p>
    <% } %>

    <%- include('./post-meta', { post: post, lang: lang }) %>
  </div>
</article>
