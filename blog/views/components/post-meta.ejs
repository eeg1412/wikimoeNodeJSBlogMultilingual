<div class="flex flex-wrap gap-3 text-sm text-slate-500 dark:text-slate-400">
  <span><%= meta.author || 'Unknown Author' %></span>
  <span><%= meta.date || 'Draft' %></span>
  <span><%= meta.sort || 'Uncategorized' %></span>
  <% if (meta.tags && meta.tags.length > 0) { %>
    <% meta.tags.forEach(function (tag) { %>
      <span>#<%= tag.tagname %></span>
    <% }) %>
  <% } %>
</div>