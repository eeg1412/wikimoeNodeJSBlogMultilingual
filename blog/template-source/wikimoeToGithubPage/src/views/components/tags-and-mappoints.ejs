<% const hasTags = Array.isArray(tags) && tags.length > 0 %>
<% const hasMappoints = Array.isArray(mappoints) && mappoints.length > 0 %>
<% if (hasTags || hasMappoints) { %>
<div class="tag-list">
  <% for (const tag of tags || []) { %>
  <a class="tag-item" href="<%= tag.href %>">#<%= tag.label %></a>
  <% } %>
  <% for (const mappoint of mappoints || []) { %>
  <a class="mappoint-tag-item" href="<%= mappoint.href %>">
    <svg class="icon-map-pin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="m11.54 22.351.07.04.028.016a.76.76 0 0 0 .723 0l.028-.015.071-.041a16.975 16.975 0 0 0 1.144-.742 19.58 19.58 0 0 0 2.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 0 0-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 0 0 2.682 2.282 16.975 16.975 0 0 0 1.145.742ZM12 13.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/></svg>
    <%= mappoint.label %>
  </a>
  <% } %>
</div>
<% } %>