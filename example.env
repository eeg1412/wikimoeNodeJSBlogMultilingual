# ========== 服务端 ==========
PORT=3100
DB_HOST=mongodb://127.0.0.1:27017/wikimoe_multilingual

# Express 请求体上限
JSON_LIMIT=20mb
URLENCODED_LIMIT=20mb

# 日志与归档
MAX_HISTORYLOGS_SIZE=100
# IP 归属库文件名（放在 server/secret 下）
IP2LOCATION_FILE_NAME=IP2LOCATION-LITE-DB11.BIN

# ========== Nuxt 博客端 ==========
NITRO_PORT=3101
NUXT_PORT=3101
NUXT_API_DOMAIN=http://127.0.0.1:3100
# Nuxt 前端运行时公开配置（用于正文内原站相对资源拼接、翻译站附件代理、canonical 域名）
NUXT_PUBLIC_SOURCE_BLOG_PUBLIC_ORIGIN=http://127.0.0.1:3000
NUXT_PUBLIC_LOCALIZED_PUBLIC_BASE_PATH=/localized
NUXT_PUBLIC_SITE_ORIGIN=http://127.0.0.1:3101

# ========== 原站数据源 ==========
# 原站博客公开接口根地址（用于 /api/blog/post/detail 等只读接口）
SOURCE_BLOG_API_BASE_URL=http://127.0.0.1:3000
# 原站公开访问域名（运行时拼接原站相对资源：/upload /content /ucloudImg /up_works /web_demo）
SOURCE_BLOG_PUBLIC_ORIGIN=http://127.0.0.1:3000

# ========== 翻译站本地附件 ==========
# 翻译站附件本地存储目录（相对 server 工作目录或绝对路径）
LOCAL_ATTACHMENT_STORAGE_DIR=./public/localized
# 翻译站附件对外公开访问路径前缀
LOCAL_ATTACHMENT_PUBLIC_BASE_PATH=/localized

# ========== 安全 ==========
JWT_SECRET_ADMIN=

# ========== AI 翻译 ==========
# @google/genai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
# 可选的 AI 网关（若为空则直连 Google）
AI_GATEWAY_URL=

# ========== 首次启动 ==========
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123456
INIT_ADMIN_NICKNAME=Admin
