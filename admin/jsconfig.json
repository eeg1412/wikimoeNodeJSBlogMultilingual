{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
