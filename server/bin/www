#!/usr/bin/env node
const app = require('../app')
const env = require('../config/env')
const { connect } = require('../mongodb')
const { ensureInitialAdmin } = require('../utils/initAdmin')
const { initDefaultOptions } = require('../utils/options')
const log4js = require('../utils/logger')
const logger = log4js.getLogger()

async function bootstrap() {
  await connect()
  await initDefaultOptions()
  await ensureInitialAdmin()
  app.listen(env.PORT, () => {
    logger.info(`Multilingual 服务已启动 :${env.PORT}`)
  })
}

bootstrap().catch(err => {
  logger.error('启动失败:', err && err.stack ? err.stack : err)
  process.exit(1)
})
