#!/usr/bin/env node

const http = require('http')
const env = require('../config/env')
const app = require('../app')
const { initializeApplicationState } = require('../services/bootstrapService')

async function main() {
  await initializeApplicationState()
  const server = http.createServer(app)
  server.listen(env.PORT, () => {
    console.info(`server listening on http://127.0.0.1:${env.PORT}`)
  })
}

main().catch(error => {
  console.error(error)
  process.exit(1)
})